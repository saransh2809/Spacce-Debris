# Base URL of the KAKSHA backend API.
#
# Local development: leave unset. The client falls back to http://127.0.0.1:8000.
#
# Vercel: set this in Project Settings -> Environment Variables to the public
# URL of your deployed backend, with NO trailing slash. Vite inlines VITE_*
# variables at BUILD time, so changing it requires a redeploy, not just a
# restart.
#
# VITE_API_BASE=https://kaksha-api.onrender.com
