# KAKSHA backend configuration. Copy to .env and fill in.
# All settings are optional except the API key for the LLM explanation layer.

# --- LLM explanation layer (explanation only; no numerical authority) -------
# Two providers are supported: Anthropic (Claude) and Google (Gemini). Supply
# ONE key. The provider is inferred from the model id, falling back to the key
# format; set KAKSHA_LLM_PROVIDER to override.
#
# Anthropic:
#   KAKSHA_ANTHROPIC_API_KEY=sk-ant-...
#   KAKSHA_LLM_MODEL=claude-opus-5
#
# Gemini:
#   KAKSHA_GEMINI_API_KEY=AIza...   (or AQ....)
#   KAKSHA_LLM_MODEL=gemini-2.5-flash
#
# Without a key the system is fully functional: the explanation panel falls
# back to a deterministic template built directly from the numbers, labelled
# as such.
KAKSHA_ANTHROPIC_API_KEY=
KAKSHA_GEMINI_API_KEY=
# KAKSHA_LLM_API_KEY=            # generic alternative to the two above
# KAKSHA_LLM_PROVIDER=auto       # auto | anthropic | gemini
KAKSHA_LLM_MODEL=gemini-2.5-flash

# --- screening pipeline ----------------------------------------------------
# KAKSHA_SCREENING_THRESHOLD_KM=25.0
# KAKSHA_DEFAULT_SCREEN_HOURS=48.0
# KAKSHA_COARSE_STEP_S=60.0
# KAKSHA_MAX_SCREEN_OBJECTS=4000

# --- data ------------------------------------------------------------------
# KAKSHA_TLE_MAX_AGE_DAYS=14.0
# KAKSHA_CATALOG_REFRESH_MINUTES=180
